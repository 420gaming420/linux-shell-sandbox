# Sandbox Configuration
# Copy this file to .env and adjust values as needed.
# All values are optional — defaults are used for any unset variables.

# Container image to use for podman sandbox sessions.
# Default: docker.io/library/python:latest
SANDBOX_CONTAINER_IMAGE=docker.io/library/python:latest

# Default container name for sandbox sessions.
# Default: sandbox
SANDBOX_CONTAINER_NAME=sandbox

# Default project directory to sandbox.
# Default: ./project/
SANDBOX_PROJECT_DIR=./project
